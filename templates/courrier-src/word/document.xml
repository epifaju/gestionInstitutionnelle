    <w:p><w:r><w:t xml:space="preserve"> </w:t></w:r></w:p>
    <w:p><w:r><w:t xml:space="preserve">Veuillez agréer, Madame, Monsieur, l’expression de nos salutations distinguées.</w:t></w:r></w:p>

    <w:p><w:r><w:t xml:space="preserve"> </w:t></w:r></w:p>
    <w:p><w:r><w:t xml:space="preserve">Signature : ____________________________</w:t></w:r></w:p>

