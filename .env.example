# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion
DB_USER=gestion
DB_PASSWORD=gestion

# JWT RS256 — générer avec :
#   ./scripts/generate-jwt-keys.sh
#   ou : .\scripts\generate-jwt-keys.ps1
# Sous Docker Compose : si la valeur contient « $ », échappez en « $$ » pour éviter l’interpolation.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=

# MinIO (compatible S3)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_BUCKET=gestion
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
#
# Optionnel: overrider l'image MinIO (utile si un volume existant a été créé avec une autre version)
# Exemple: MINIO_IMAGE=minio/minio:latest
MINIO_IMAGE=

# CORS — origine du navigateur (ex. http://localhost sans port si nginx sur 80)
# En prod : https://votre-domaine (obligatoire) — vérifier avec ./scripts/check-prod-env.sh
FRONTEND_URL=http://localhost

# Frontend (Docker) — URL publique de l’API (chemin derrière nginx)
NEXT_PUBLIC_API_URL=/api
INTERNAL_API_URL=http://backend:8080/api

# Cookie refresh HttpOnly : Secure=true requis en HTTPS (production)
REFRESH_COOKIE_SECURE=false

# Email / SMTP (notifications par email)
# Activer l'envoi d'emails applicatifs (si false, aucun email n'est envoyé)
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@gestion.local

# SMTP (Spring Mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Actuator healthcheck mail (sinon le backend peut être "unhealthy" si SMTP non configuré)
EMAIL_HEALTH_ENABLED=false
